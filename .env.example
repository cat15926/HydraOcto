# 单机服务，仅监听 127.0.0.1。
APP_PORT=4310
APP_DATA_DIR=.local-data
APP_WORKSPACE=.local-data/workspace

# 持续协作：默认使用本机官方 CLI 登录；可按需指定二进制。
# COLLAB_CODEX_PATH=/absolute/path/to/codex
# 可选。项目专用官方账户的私有登录/历史目录，默认 .local-data/project-runtime/codex-login。
# COLLAB_CODEX_PROJECT_HISTORY_HOME=/absolute/private/path/codex-project-login
# COLLAB_CLAUDE_PATH=/absolute/path/to/claude
# 仅在本机 Linux VM 的目录绑定、执行域退出和 API 承载验收通过后设置。
# COLLAB_PROJECT_VM_CONFIG=/absolute/private/path/project-vm.json
# Hermes Agent 0.18.2 默认使用 ~/.hermes/hermes-agent/venv/bin/python
# COLLAB_HERMES_PYTHON=/absolute/path/to/hermes/venv/bin/python
# API 账户在页面只填写环境变量名（例如 ANTHROPIC_API_KEY）、根地址及模型。
# 兼容接口的模型可能来自其他供应商，请使用服务实际支持的模型标识。
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# 以下配置只对应 /?legacy=1 的旧顺序任务模式。
# 指向支持 Chat Completions 工具调用协议的服务，通常以 /v1 结尾。
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=

# Optional read-only MCP search sources for authorized project authors. Configure a tool
# audited by the operator with a read-only credential. Set its fixed endpoint, tool and
# single text argument here. Only the label, host and tool name are shown in the UI.
# COLLAB_MCP_READERS=[{"id":"handbook","label":"团队手册","url":"https://docs.example.org/mcp","readOnly":true,"tool":"search_docs","parameter":"query","tokenEnv":"COLLAB_MCP_TOKEN_HANDBOOK"}]
